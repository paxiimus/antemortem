# Ante Mortem — production .env. Copy to /opt/antemortem/.env on the box. Never commit.
GHCR_OWNER=paxiimus
DOMAIN=api.antemortem.fyi          # Caddy issues the cert for this; A record must point at the box

DEBUG=0
DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(64))"
ALLOWED_HOSTS=api.antemortem.fyi
CSRF_TRUSTED_ORIGINS=https://api.antemortem.fyi,https://app.antemortem.fyi
CORS_ALLOWED_ORIGINS=https://app.antemortem.fyi
APP_URL=https://api.antemortem.fyi     # public cemetery + links in emails live here

DB_NAME=antemortem
DB_USER=antemortem
DB_PASSWORD=                  # python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_CONN_MAX_AGE=60
CELERY_CONCURRENCY=2

# App links (universal links / app links for /c/<token> handoff)
IOS_APP_ID=TEAMID.com.paxiimus.antemortem
ANDROID_CERT_FINGERPRINTS=            # SHA256 of the Play signing cert, comma-separated if several
IOS_URL=https://apps.apple.com/app/idXXXX
ANDROID_URL=https://play.google.com/store/apps/details?id=com.paxiimus.antemortem

# Postmark — dedicated server/stream so sender reputation stays isolated
POSTMARK_TOKEN=
POSTMARK_STREAM=antemortem
DEFAULT_FROM_EMAIL=Ante Mortem <noreply@antemortem.fyi>

# Off-site backups (deploy.sh backup-offsite, nightly via systemd timer)
# rclone remote configured on the box: `rclone config` → name it r2 (Cloudflare R2, S3 API)
BACKUP_RCLONE_REMOTE=r2:antemortem-backups
BACKUP_AGE_RECIPIENT=age1...  # public key; keep the private key OFF the box
