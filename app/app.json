{
  "expo": {
    "name": "Ante Mortem",
    "slug": "antemortem",
    "scheme": "antemortem",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.paxiimus.antemortem",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:api.antemortem.fyi"
      ]
    },
    "android": {
      "package": "com.paxiimus.antemortem",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.antemortem.fyi",
              "pathPrefix": "/c"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0b0d"
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0b0b0d"
  }
}
