{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@antemortem/crypto": [
        "../packages/crypto/src/index.ts"
      ],
      "@antemortem/core": [
        "../packages/core/src/index.ts"
      ],
      "jotai": [
        "./node_modules/jotai"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
