{
  "name": "antemortem-app",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "bash ../scripts/setup-mobile.sh",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "doctor": "npx expo-doctor && npx expo install --check",
    "typecheck": "tsc --noEmit",
    "eas-build-post-install": "cd ../packages/crypto && npm ci --ignore-scripts && cd ../core && npm ci --ignore-scripts"
  },
  "dependencies": {
    "@antemortem/core": "file:../packages/core",
    "@babel/core": "^7.29.7",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.2",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@types/react": "~19.3.0",
    "buffer": "^6.0.3",
    "expo": "~58.0.26",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "jotai": "^2.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-get-random-values": "^2.1.0",
    "react-native-libsodium": "^1.7.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "typescript": "~6.0.3"
  },
  "license": "MIT",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-libsodium"
        ]
      }
    }
  }
}
